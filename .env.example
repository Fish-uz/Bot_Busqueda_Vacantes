# Telegram: obtén API_ID y API_HASH en https://my.telegram.org/
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=tu_api_hash

# IDs numéricos de grupos y canales, separados por comas.
# Para Kuentro, únete a @kuentroapp y obtén su ID con client_telegram.py.
TELEGRAM_GRUPOS_VACANTES=-1001234567890,-1009876543210

# Configura al menos uno de los dos proveedores de IA.
GROQ_API_KEY=tu_clave_groq
GEMINI_API_KEY=tu_clave_gemini

# Opciones de Telegram
TELEGRAM_DESTINO=me
TELEGRAM_SESSION=sesion_frank

# Modelos
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-3.5-flash

# OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=spa

# Archivos locales
VACANTES_DB_PATH=vacantes_data.db
OCR_LOG_PATH=log_ocr.txt
TEMP_IMAGES_DIR=temp_images
